{
  "name": "blog.naturalclar.dev",
  "version": "0.1.0",
  "private": true,
  "description": "My Tech Blog, powered by Next.js",
  "keywords": [
    "nextjs",
    "blog"
  ],
  "homepage": "https://blog.naturalclar.dev",
  "bugs": {
    "url": "https://github.com/Naturalclar/blog.naturalclar.dev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naturalclar/blog.naturalclar.dev.git"
  },
  "license": "MIT",
  "author": "Jesse Katsumata <jesse.katsumata@gmail.com>",
  "main": "n/a",
  "scripts": {
    "build": "next build && node scripts/copy-post-assets.js && node scripts/generate-rss.mjs",
    "dev": "next dev",
    "format": "biome check --write",
    "lint": "biome check",
    "lint:text": "textlint \"content/blog/*/index.md\"",
    "links": "node scripts/check-links.mjs",
    "new": "scaffdog generate",
    "ogp": "node scripts/fetch-ogp.mjs",
    "start": "pnpm dlx serve out"
  },
  "dependencies": {
    "feed": "^6.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-from-html": "^2.0.3",
    "highlight.js": "11.12.0",
    "lowlight": "3.3.0",
    "mdast-util-to-string": "4.0.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-highlight": "7.0.2",
    "rehype-stringify": "10.0.1",
    "remark": "^15",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "11.1.2",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "scaffdog": "^4.1.0",
    "tailwindcss": "4.3.3",
    "textlint": "15.8.0",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "typescript": "^7.0.2"
  },
  "volta": {
    "node": "22.0.0"
  },
  "packageManager": "pnpm@9.15.2"
}
